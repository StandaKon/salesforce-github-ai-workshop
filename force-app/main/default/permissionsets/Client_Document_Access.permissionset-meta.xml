<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Client Document Access</label>
    <description>Grants all internal standard users object and field-level access (create, read, edit, delete) to Client Document records and their custom fields. Record-level access is inherited from the related Account via the Master-Detail relationship, not controlled by this permission set.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Client_Document__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Client_Document__c.Document_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Client_Document__c.Document_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Client_Document__c.Expiration_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Client_Document__c.Issue_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
