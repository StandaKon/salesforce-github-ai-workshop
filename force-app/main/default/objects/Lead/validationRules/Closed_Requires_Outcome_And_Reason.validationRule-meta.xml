<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Requires_Outcome_And_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status, &quot;Closed&quot;) &amp;&amp; (ISBLANK(TEXT(Outcome__c)) || ISBLANK(TEXT(Closing_Reason__c)))</errorConditionFormula>
    <errorMessage>Outcome and Closing Reason are required when a Lead is Closed.</errorMessage>
</ValidationRule>
