<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closing_Reason_Required_When_Closed</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISPICKVAL(Status, &quot;Closed - Won&quot;), ISPICKVAL(Status, &quot;Closed - Lost&quot;)) &amp;&amp; ISBLANK(TEXT(Closing_Reason__c))</errorConditionFormula>
    <errorDisplayField>Closing_Reason__c</errorDisplayField>
    <errorMessage>Please select a Closing Reason before closing this Lead.</errorMessage>
</ValidationRule>
