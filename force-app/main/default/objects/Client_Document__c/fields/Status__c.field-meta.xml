<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <label>Document Status</label>
    <description>The current status of the document. Defaults to Valid on creation, is set to Expired automatically by the nightly Client Document Auto Expire scheduled flow once past its Expiration Date, or is set manually to Revoked to retire a document without deleting it.</description>
    <inlineHelpText>Valid, Expired, or Revoked.</inlineHelpText>
    <type>Picklist</type>
    <trackHistory>true</trackHistory>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Valid</fullName>
                <default>true</default>
                <label>Valid</label>
            </value>
            <value>
                <fullName>Expired</fullName>
                <default>false</default>
                <label>Expired</label>
            </value>
            <value>
                <fullName>Revoked</fullName>
                <default>false</default>
                <label>Revoked</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
