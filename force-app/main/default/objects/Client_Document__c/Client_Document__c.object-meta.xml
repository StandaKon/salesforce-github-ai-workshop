<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Client Document</label>
    <pluralLabel>Client Documents</pluralLabel>
    <description>Stores identification and legal documents (e.g. passport, ID card, contract) associated with a client Account.</description>
    <sharingModel>ReadWrite</sharingModel>
    <deploymentStatus>Deployed</deploymentStatus>
    <visibility>Public</visibility>
    <enableActivities>true</enableActivities>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <nameField>
        <label>Client Document Name</label>
        <type>AutoNumber</type>
        <displayFormat>CD-{0000}</displayFormat>
        <startingNumber>0</startingNumber>
    </nameField>
    <validationRules>
        <fullName>IssueDateNotInFuture</fullName>
        <active>true</active>
        <description>Prevents entering an Issue Date later than today, since a document cannot be issued in the future.</description>
        <errorConditionFormula>Issue_Date__c &gt; TODAY()</errorConditionFormula>
        <errorDisplayField>Issue_Date__c</errorDisplayField>
        <errorMessage>Issue Date cannot be later than today.</errorMessage>
    </validationRules>
</CustomObject>
