<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Client Document</label>
    <pluralLabel>Client Documents</pluralLabel>
    <description>Object used to track and manage structured information about documents belonging to a client (e.g. ID Card, Passport) within the organization. Each record is a child of an Account via a Master-Detail relationship.</description>
    <sharingModel>ControlledByParent</sharingModel>
    <deploymentStatus>Deployed</deploymentStatus>
    <visibility>Public</visibility>
    <enableSearch>true</enableSearch>
    <enableReports>true</enableReports>
    <enableActivities>true</enableActivities>
    <enableHistory>true</enableHistory>
    <nameField>
        <label>Client Document Name</label>
        <type>AutoNumber</type>
        <displayFormat>CD-{0000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
</CustomObject>
