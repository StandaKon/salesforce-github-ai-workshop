<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>

    <choices>
        <name>Choice_Cancel</name>
        <choiceText>Cancel</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Cancel</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_CreateAnyway</name>
        <choiceText>Create Anyway</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>CreateAnyway</stringValue>
        </value>
    </choices>

    <decisions>
        <name>Duplicate_Check_Decision</name>
        <label>Duplicate Check Decision</label>
        <locationX>50</locationX>
        <locationY>450</locationY>
        <defaultConnector>
            <targetReference>Create_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Match Found</defaultConnectorLabel>
        <rules>
            <name>Match_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_By_Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Possible_Duplicate</targetReference>
            </connector>
            <label>Match Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Duplicate_Screen_Decision</name>
        <label>Duplicate Screen Decision</label>
        <locationX>200</locationX>
        <locationY>750</locationY>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>Create_Anyway_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>User_Choice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CreateAnyway</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Lead</targetReference>
            </connector>
            <label>Create Anyway</label>
        </rules>
    </decisions>

    <interviewLabel>Lead Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Request</label>
    <processType>Flow</processType>

    <recordCreates>
        <name>Create_Lead</name>
        <label>Create Lead</label>
        <locationX>50</locationX>
        <locationY>900</locationY>
        <connector>
            <targetReference>Confirmation</targetReference>
        </connector>
        <inputAssignments>
            <field>Company</field>
            <value>
                <elementReference>Company</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <elementReference>FirstName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>LastName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email</field>
            <value>
                <elementReference>Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone</field>
            <value>
                <elementReference>PrimaryPhone</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Secondary_Phone__c</field>
            <value>
                <elementReference>SecondaryPhone</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Street</field>
            <value>
                <elementReference>Street</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>City</field>
            <value>
                <elementReference>City</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>State</field>
            <value>
                <elementReference>State</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PostalCode</field>
            <value>
                <elementReference>PostalCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country</field>
            <value>
                <elementReference>Country</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <recordLookups>
        <name>Get_Lead_By_Email</name>
        <label>Get Lead By Email</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Duplicate_Check_Decision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <runInMode>DefaultMode</runInMode>

    <screens>
        <name>Lead_Details</name>
        <label>Lead Details</label>
        <locationX>50</locationX>
        <locationY>150</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Get_Lead_By_Email</targetReference>
        </connector>
        <fields>
            <name>Company</name>
            <fieldText>Company</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>FirstName</name>
            <fieldText>First Name</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>LastName</name>
            <fieldText>Last Name</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Email</name>
            <fieldText>Email</fieldText>
            <fieldType>ComponentInstance</fieldType>
            <dataType>String</dataType>
            <extensionName>flowruntime:email</extensionName>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Email</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>required</name>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </inputParameters>
        </fields>
        <fields>
            <name>PrimaryPhone</name>
            <fieldText>Primary Phone</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>SecondaryPhone</name>
            <fieldText>Secondary Phone</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Street</name>
            <fieldText>Street</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>City</name>
            <fieldText>City</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>State</name>
            <fieldText>State/Province</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>PostalCode</name>
            <fieldText>Postal Code</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Country</name>
            <fieldText>Country</fieldText>
            <fieldType>InputField</fieldType>
            <dataType>String</dataType>
            <isRequired>false</isRequired>
        </fields>
    </screens>
    <screens>
        <name>Possible_Duplicate</name>
        <label>Possible Duplicate</label>
        <locationX>200</locationX>
        <locationY>600</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Duplicate_Screen_Decision</targetReference>
        </connector>
        <fields>
            <name>Duplicate_Warning_Text</name>
            <fieldType>DisplayText</fieldType>
            <fieldText><![CDATA[<p>A Lead with this email address already exists: <a href="/lightning/r/Lead/{!Get_Lead_By_Email.Id}/view" target="_blank">{!Get_Lead_By_Email.Name}</a></p><p>You can cancel this request, or create a new Lead anyway.</p>]]></fieldText>
        </fields>
        <fields>
            <name>User_Choice</name>
            <fieldText>What would you like to do?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <dataType>String</dataType>
            <isRequired>true</isRequired>
            <choiceReferences>Choice_Cancel</choiceReferences>
            <choiceReferences>Choice_CreateAnyway</choiceReferences>
            <defaultSelectedChoiceReference>Choice_Cancel</defaultSelectedChoiceReference>
        </fields>
    </screens>
    <screens>
        <name>Confirmation</name>
        <label>Confirmation</label>
        <locationX>50</locationX>
        <locationY>1050</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Confirmation_Text</name>
            <fieldType>DisplayText</fieldType>
            <fieldText><![CDATA[<p>The Lead was created successfully.</p><p><a href="/lightning/r/Lead/{!Create_Lead}/view" target="_blank">View the new Lead</a></p>]]></fieldText>
        </fields>
    </screens>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Lead_Details</targetReference>
        </connector>
    </start>

    <status>Active</status>
</Flow>
